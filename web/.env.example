# GAS 웹앱 배포 URL (…/exec 로 끝나는 주소)
# 이 값은 빌드된 JS에 그대로 들어가므로 공개돼도 괜찮은 값만 넣습니다. PIN은 여기 넣지 마세요.
VITE_GAS_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# 웹 푸시 VAPID 공개키 (npx web-push generate-vapid-keys 로 만든 Public Key)
# 개인키(Private Key)는 여기 넣지 말고 Vercel 환경변수 VAPID_PRIVATE_KEY에만 넣습니다.
VITE_VAPID_PUBLIC_KEY=
